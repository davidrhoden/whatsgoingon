---
title: Clients
metaDescription: This page lists all of the site's clients.
layout: layouts/base.njk
pagination:
  data: collections.clients
  size: Infinity
permalink: "clients/index.html"
---

<h1>{{ title }}</h1>

<section class="clients">
  {% for client in pagination.items %}
    <article class="class{{ loop.index }} {{ client | slug }}">
      <h3>
        <a href="/clients/{{ client | slug }}">{{ client | safe }} {{ collections.clients[client].length }}</a>
      </h3>
    </article>
  {% endfor %}
  <nav>
    <a href="{{ '/blog/' | url }}">← Blog index</a>
  </nav>
</section>

