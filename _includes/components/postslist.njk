<section>
	{% for post in postslist | reverse %}

		{% set isImageOnly = post.data.image and not post.data.title %}
		<article data-slug="{{ post.fileSlug }}" class="class{{ loop.index }} {{ post.data.author | slug }}
		{% if post.data.tags %}
				{% for tag in post.data.tags %}
	  			{%- if tag == "completed" -%}
	  				{% set completedClass %}{{ tag }}{% endset %}
	  			{{ completedClass }}
	  			{%- endif -%}
				{% endfor %}
		{% endif %}
		{% if isImageOnly %}image-only{% endif %}">
			<div class="centerer">
				{% if isImageOnly %}
					<img src="{{ post.data.image }}" alt="">
				{% else %}
					{% if post.data.title %}
						<h3>
							<a href="{{ post.url | url }}">{{ post.data.title }}</a>
						</h3>
					{% endif %}
					{% if post.data.image %}
						<img src="{{ post.data.image }}" alt="{{ post.data.title }}">
					{% endif %}
					{% if post.data.summary %}
						<p>
							{{ post.data.summary }}
						</p>
					{% endif %}
					<p>
						<time datetime="{{ post.date | machineDate }}">
							<small>{{ post.date | readableDate }} by <a href="/authors/{{ post.data.author | slug }}/">{{ post.data.author }}</a></small>
						</time>
					</p>
					{% if post.data.tags %}
						<p>
							{% for tag in post.data.tags %}
				  			{%- if tag != "post" -%}
				  				{% set tagUrl %}/tags/{{ tag }}/{% endset %}
				  			<a href="{{ tagUrl | url }}" rel="tag">{{ tag }}</a>
				  			{%- endif -%}
							{% endfor %}
						</p>
					{% endif %}
				{% endif %}
			</div>
		</article>
	{% endfor %}
</section>
