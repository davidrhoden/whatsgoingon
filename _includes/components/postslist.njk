<section>
	{% for post in postslist | reverse %}

		{% set isImageOnly = post.data.image and not post.data.title %}
		{% set hasImage = post.data.image and post.data.title %}
		{% set client = clients | clientByName(post.data.client) %}
		<article data-slug="{{ post.fileSlug }}" class="class{{ loop.index }} {{ post.data.client | slug }}
		{% if post.data.status == "done" %}completed{% elif post.data.status == "wontdo" %}wontdo{% endif %}
		{% if isImageOnly %}image-only{% endif %}
		{% if hasImage %}has-image{% endif %}"{% if client and client.color %} style="background: {{ client.color }};"{% endif %}>
			<div class="centerer">
				{% if isImageOnly %}
					<img src="{{ post.data.image }}" alt="">
				{% else %}
					<div class="post-text">
					{% if post.data.title %}
						<h3>
							<a href="{{ post.url | url }}">{{ post.data.title | smartQuotes }}</a>
						</h3>
					{% endif %}
					{% if post.data.summary %}
						<p class="summary">
							{{ post.data.summary | smartQuotes }}
						</p>
					{% endif %}
					<p class="meta">
						<time datetime="{{ post.date | machineDate }}">
							{{ post.date | readableDate }} <br>
							<a href="/clients/{{ post.data.client | slug }}/">{{ post.data.client }}</a> <br>
							{% if post.data.dueDate %}Due: {{ post.data.dueDate | readableDate }} <br>{% endif %}
							{% set age = post.date | daysOld %}{{ age }} {{ "day" if age == 1 else "days" }} old
						</time>
					</p>
					{% if post.data.tags %}
						<p>
							{% for tag in post.data.tags %}
				  			{%- if tag != "post" -%}
				  				{% set tagUrl %}/tags/{{ tag | slug }}/{% endset %}
				  			<a href="{{ tagUrl | url }}" rel="tag">{{ tag }}</a>
				  			{%- endif -%}
							{% endfor %}
						</p>
					{% endif %}
					</div>
					{% if hasImage %}
						<img src="{{ post.data.image }}" alt="{{ post.data.title }}">
					{% endif %}
				{% endif %}
			</div>
		</article>
	{% endfor %}
</section>
