---
layout: layouts/base.njk
section: done
---

{{ layoutContent | safe }}

<p><a href="/">&larr; Back to task tracker</a></p>

<section class="done-list">
	{% if collections.done | length == 0 %}
		<p id="done-empty">No completed tasks yet.</p>
	{% else %}
		{% for post in collections.done | reverse %}
			<article class="done-item">
				<h3>
					<a href="{{ post.url | url }}">{{ (post.data.title or post.fileSlug) | smartQuotes }}</a>
				</h3>
				<ul class="done-meta">
					<li><strong>Client:</strong> <a href="/clients/{{ post.data.client | slug }}/">{{ post.data.client }}</a></li>
					{% if post.data.tags %}
						<li><strong>Tags:</strong>
							{% for tag in post.data.tags %}
				  				{%- if tag != "post" -%}
				  					<a href="/tags/{{ tag | slug }}/" rel="tag">{{ tag }}</a>{% if not loop.last %} {% endif %}
				  				{%- endif -%}
							{% endfor %}
						</li>
					{% endif %}
					<li><strong>Age at completion:</strong> {% set age = post.date | ageAtCompletion(post.data.completedDate) %}{{ age }} {{ "day" if age == 1 else "days" }}</li>
				</ul>
			</article>
		{% endfor %}
	{% endif %}
</section>
