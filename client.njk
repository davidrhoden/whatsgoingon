---
title: Client archive
layout: layouts/base.njk
pagination:
  data: collections.clients
  size: 1
  alias: client
permalink: "clients/{{ client | slug }}/"
renderData:
  client: "{{ client }}"
  title: "Tasks for {{ client }}"
  metaDescription: "An archive of all posts by the client: {{ client }}."
---

<h1>{{ renderData.title | safe }}</h1>

<section>
	{% for post in collections.clients[client] | reverse %}
		<article class="class{{ loop.index }} {{ client | slug }}">
			<div class="centerer">
				<h3>
					<a href="{{ post.page.url | url }}">
						{% if post.title %}
							{{ post.title }}
						{% else %}
							Untitled
						{% endif %}
					</a>
				</h3>
				{% if post.summary %}
					<p>
						{{ post.summary }}
					</p>
				{% endif %}
				<p>
					<time datetime="{{ post.date | machineDate }}">
						<small>{{ post.date | readableDate }} by <a href="/clients/{{ post.client | slug }}/">{{ post.client }}</a></small>
					</time>
				</p>
				{% if post.tags %}
					<p>
						{% for tag in post.tags %}
			  			{%- if tag != "post" -%}
			  				{% set tagUrl %}/tags/{{ tag }}/{% endset %}
			  			<a href="{{ tagUrl | url }}" rel="tag">{{ tag }}</a>
			  			{%- endif -%}
						{% endfor %}
					</p>
				{% endif %}
			</div>
		</article>
	{% endfor %}
  <nav>
    <a href="{{ '/clients/' | url }}">← Clients index</a>
  </nav>
</section>
